{
  "name": "claude-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Hosted multi-account MCP connector for Claude: Google Workspace (Gmail, Calendar, Drive, Docs, Sheets) + Hansberry Slack",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/web-api": "^8.5.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "googleapis": "^190.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
